{
  "name": "siyuan-dodo",
  "version": "1.0.1",
  "type": "module",
  "description": "渡渡鸟工具箱：思源笔记数据库视图、Excalidraw、附件管理与编辑增强",
  "repository": "https://github.com/onemonet/siyuan-dodo",
  "homepage": "https://github.com/onemonet/siyuan-dodo",
  "author": "养恐龙",
  "license": "MIT",
  "scripts": {
    "make-link": "node  --no-warnings ./scripts/make_dev_link.js",
    "dev": "node scripts/build-frappe-gantt.mjs && node scripts/dev.mjs --watch",
    "build": "node scripts/build-frappe-gantt.mjs && vite build --config vite.excalidraw.config.ts && vite build",
    "build:marketplace": "node scripts/build-frappe-gantt.mjs && cross-env DODO_BUILD_TARGET=marketplace vite build",
    "verify:marketplace": "node scripts/verify-marketplace-package.mjs",
    "build:install": "pnpm run build && node scripts/sync-build.mjs",
    "install:local": "node scripts/sync-build.mjs",
    "install:preview": "node scripts/sync-build.mjs --dry-run",
    "test:map": "node scripts/test-unified-view-storage.mjs && node scripts/test-native-database-views.mjs && node scripts/test-map-point-context-menu.mjs && node scripts/test-map-item-right-split.mjs && node scripts/test-map-point-correction.mjs && node scripts/test-map-persistent-host.mjs && node scripts/test-map-filter-refresh.mjs && node scripts/test-av-field-binding.mjs && node scripts/test-map-locate-existing.mjs",
    "test:map-locate-browser": "python scripts/test-map-locate-browser.py",
    "test:map-locate-existing": "node scripts/test-map-locate-existing.mjs",
    "test:map-context-menu": "node scripts/test-map-point-context-menu.mjs",
    "test:map-item-open": "node scripts/test-map-item-right-split.mjs",
    "test:map-correction": "node scripts/test-map-point-correction.mjs",
    "test:map-persistent-host": "node scripts/test-map-persistent-host.mjs",
    "test:map-filter": "node scripts/test-map-filter-refresh.mjs",
    "test:database-view-core": "node scripts/test-database-view-core.mjs && node scripts/test-database-view-architecture.mjs && node scripts/test-visual-view-registry.mjs && node scripts/test-timeline-render-order.mjs && node scripts/test-unified-view-storage.mjs && node scripts/test-database-custom-agent-create.mjs && node scripts/test-unified-av-standard.mjs",
    "test:unified-views": "node scripts/test-unified-view-storage.mjs",
    "test:native-views": "node scripts/test-native-database-views.mjs",
    "test:calendar": "node scripts/test-database-calendar.mjs && node scripts/test-database-calendar-create.mjs",
    "test:database-view-settings": "node scripts/test-database-view-feature-settings.mjs",
    "test:map-delete-dialog": "node scripts/test-map-delete-dialog.mjs",
    "test:visual": "node scripts/test-unified-view-storage.mjs && node scripts/test-native-database-views.mjs && node scripts/test-database-view-feature-settings.mjs && node scripts/test-chart-settings-autosave.mjs && node scripts/test-timeline-auto-save.mjs",
    "test:chart-width": "node scripts/test-chart-full-width.mjs",
    "test:chart-settings": "node scripts/test-chart-settings-autosave.mjs",
    "test:chart-colors": "node scripts/test-chart-open-color.mjs",
    "test:preview-height": "node scripts/test-preview-height.mjs",
    "test:chart-y": "node scripts/test-chart-y-axis.mjs",
    "test:timeline-preview": "node scripts/test-timeline-preview.mjs",
    "test:timeline-colors": "node scripts/test-timeline-colors.mjs",
    "test:timeline-mapping": "node scripts/test-timeline-mapping.mjs",
    "test:timeline-date-range": "node scripts/test-timeline-date-range.mjs",
    "test:timeline-navigation": "node scripts/test-timeline-title-navigation.mjs && node scripts/test-timeline-preserve-navigation.mjs",
    "test:timeline-autosave": "node scripts/test-timeline-auto-save.mjs",
    "test:field-tooltips": "node scripts/test-field-tooltips.mjs",
    "test:auto-binding": "node scripts/test-auto-field-binding.mjs",
    "test:unit": "cross-env TS_NODE_TRANSPILE_ONLY=true node --loader ts-node/esm --experimental-specifier-resolution=node tests/run-unit-tests.ts",
    "test:notion": "node scripts/test-notion-markdown.mjs && node scripts/test-notion-api.mjs && node scripts/test-notion-media.mjs && node scripts/test-notion-incremental.mjs",
    "test:av-fields": "node scripts/test-av-field-binding.mjs",
    "test:create-av-field": "node scripts/test-create-av-field.mjs",
    "test:unified-av-standard": "node scripts/test-unified-av-standard.mjs",
    "test:database-custom-agent": "node scripts/test-database-custom-agent-create.mjs",
    "test:database-custom-ui": "node scripts/test-dodo-custom-view-skill.mjs && python scripts/test-database-custom-ui-browser.py",
    "test:excalidraw:boolean-repeat-menu": "python scripts/test-excalidraw-browser.py --boolean-repeat-menu",
    "test:excalidraw:spacing": "python scripts/test-excalidraw-browser.py --spacing-handle-states",
    "test:excalidraw:right-drag": "python scripts/test-excalidraw-browser.py --right-drag-real",
    "test:excalidraw": "node scripts/test-excalidraw-api-callback.mjs && node scripts/test-excalidraw-export-adapter.mjs && node scripts/test-excalidraw-browser-port.mjs && node scripts/test-excalidraw-canvas.mjs && node scripts/test-excalidraw-integration.mjs && node scripts/test-excalidraw-toolbar.mjs && node scripts/test-excalidraw-mindmap.mjs && node scripts/test-excalidraw-boolean.mjs && node scripts/test-excalidraw-closed-background.mjs && node scripts/test-excalidraw-agent-capabilities.mjs",
    "test:excalidraw-browser": "python scripts/test-excalidraw-browser.py",
    "test:excalidraw-svg": "python -u scripts/test-excalidraw-browser.py --edit-svg",
    "test:excalidraw-toolbar": "node scripts/test-excalidraw-toolbar.mjs && python scripts/test-excalidraw-browser.py --toolbar"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^3.1.0",
    "@tsconfig/svelte": "^4.0.1",
    "@types/crypto-js": "^4.2.2",
    "@types/d3-hierarchy": "3.1.7",
    "@types/node": "^20.3.0",
    "@types/react": "^19.2.4",
    "@types/react-dom": "^19.2.3",
    "cross-env": "^7.0.3",
    "esbuild": "0.21.5",
    "fast-glob": "^3.2.12",
    "glob": "^10.0.0",
    "js-yaml": "^4.1.0",
    "lucide-svelte": "^1.0.1",
    "minimist": "^1.2.8",
    "rollup-plugin-livereload": "^2.0.5",
    "sass": "^1.63.3",
    "siyuan": "1.1.6",
    "svelte": "^4.2.19",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.3",
    "vite": "^5.2.9",
    "vite-plugin-static-copy": "^1.0.2",
    "vite-plugin-zip-pack": "^1.0.5"
  },
  "dependencies": {
    "@dicebear/core": "9.4.2",
    "@dicebear/core-modern": "npm:@dicebear/core@10.7.0",
    "@dicebear/open-peeps": "9.4.2",
    "@dicebear/styles": "10.6.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@excalidraw/excalidraw": "0.18.0-3c916c5",
    "@excalidraw/mermaid-to-excalidraw": "2.2.2",
    "@frostime/siyuan-plugin-kits": "^1.5.14",
    "@iconify-json/icon-park-outline": "1.2.4",
    "@iconify-json/icon-park-solid": "1.2.4",
    "@iconify-json/icon-park-twotone": "1.2.4",
    "@iconify-json/lucide": "1.2.150",
    "@iconify-json/ph": "1.2.2",
    "@iconify-json/tabler": "1.2.43",
    "@siyuan-community/siyuan-sdk": "^0.3.14",
    "@zumer/snapdom": "^2.0.2",
    "bits-ui": "0.22.0",
    "crypto-js": "^4.2.0",
    "d3-hierarchy": "3.1.2",
    "epubjs": "^0.3.93",
    "fullcalendar": "7.1.3",
    "gridstack": "13.2.0",
    "html2canvas-pro": "^1.4.3",
    "jinja-js": "^0.1.8",
    "jszip": "3.10.1",
    "lodash": "^4.17.21",
    "lucide-react": "^1.65.0",
    "moment": "^2.30.1",
    "muuri": "0.9.5",
    "nanoid": "^5.1.6",
    "react": "^19.2.0",
    "react-colorful": "^5.8.1",
    "react-dom": "^19.2.0",
    "simple-mind-map": "0.14.0-fix.3",
    "svg-to-excalidraw": "0.0.2",
    "temporal-polyfill": "^1.0.6",
    "ts-md5": "^2.0.1",
    "turndown": "^7.2.2",
    "vditor": "^3.11.2"
  }
}
